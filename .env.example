# Copy to .env (npm run first-run does this for you). .env is git-ignored.
#
# This app needs NO secrets to run: no accounts, no API keys, no servers.
# If you ever add a credential for your own tooling (e.g. an EAS token for
# cloud builds), put it in .env and never commit it.
#
# Note: variables prefixed EXPO_PUBLIC_ are embedded in the app bundle and are
# NOT secret. Only use that prefix for non-sensitive flags like the one below.

# Opt-in health integration (HealthKit on iOS, Health Connect on Android).
# Requires a development build (npx expo run:ios / run:android); has no effect
# in Expo Go or on web. Default: false.
EXPO_PUBLIC_HEALTH_ENABLED=false

# Optional, for your own cloud builds only. Leave empty for local use.
# EXPO_TOKEN=
